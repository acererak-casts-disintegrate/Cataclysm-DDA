msgid_plural "pairs of carbon fiber gauntlets"
msgstr[0] "pair of carbon fibre gauntlets"
msgstr[1] "pairs of carbon fibre gauntlets"

msgid "A custom pair of leather gauntlets armored with layered carbon fiber made using a 3D printer.  Its rigid plates are more comparable to plate armor than Kevlar, but it's very protective and lightweight."
msgstr "A custom pair of leather gauntlets armoured with layered carbon fibre made using a 3D printer.  Its rigid plates are more comparable to plate armour than Kevlar, but it's very protective and lightweight."

